# Vercel server environment. Never prefix these with NEXT_PUBLIC_.
APP_URL=https://your-gold-gym-domain.example
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
# Transaction pooler URI, from the project's Connect panel. Keep the password secret.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER:6543/postgres
# UUID of the verified owner account created in this project's Supabase Auth.
GOLD_GYM_OWNER_ID=replace-with-owner-auth-uuid
# SMS enrollment is enabled after configuring the provider and approving its cost.
GOLD_GYM_SMS_MFA_ENABLED=false
